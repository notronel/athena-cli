# Do not commit an actual .env file. Export these values in your shell instead.
ATHENA_CLIENT_ID=
ATHENA_CLIENT_SECRET=
ATHENA_SERVICE_USERNAME=
ATHENA_SERVICE_PASSWORD=
ATHENA_SCOPE="system/Patient.rs system/DocumentReference.rs"

# FHIR R4 SMART v2 sandbox defaults. Override only when athenahealth supplies different URLs.
ATHENA_FHIR_BASE_URL=https://ap25sandbox.fhirapi.athenahealth.com/demoAPIServer
# ATHENA_TOKEN_URL=https://your-server/oauth2/token
ATHENA_TIMEOUT_SECONDS=20
